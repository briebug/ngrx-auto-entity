{
  "name": "ngrx-auto-entity-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "projects/ngrx-auto-entity-service/src",
  "projectType": "library",
  "prefix": "ae",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "configurations": {
        "production": {
          "tsConfig": "projects/ngrx-auto-entity-service/tsconfig.lib.prod.json",
          "project": "projects/ngrx-auto-entity-service/ng-package.prod.json"
        },
        "development": {
          "tsConfig": "projects/ngrx-auto-entity-service/tsconfig.lib.json",
          "project": "projects/ngrx-auto-entity-service/ng-package.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "projects/ngrx-auto-entity-service/jest.config.ts"
      },
      "configurations": {
        "coverage": {
          "collectCoverage": true
        },
        "ci": {
          "ci": true,
          "testResultsProcessor": "jest-junit"
        }
      }
    }
  }
}
